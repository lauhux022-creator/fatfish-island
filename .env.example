# Node room service and local Vite proxy
PORT=8797
ROOM_HOST=127.0.0.1
# Additional comma-separated browser origins for a separately hosted room server
# ROOM_ORIGINS=https://lauhux022-creator.github.io

# Optional public WebSocket address for the client build
# VITE_ROOM_URL=wss://rooms.example.com/fatfish-island/rooms

# Optional Node-only boss configuration. Without a key rooms use MockBrain.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
