{
  "name": "fatfish-island",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names Node,Vite \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:client": "vite --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --strictPort",
    "test:smoke": "node scripts/smoke.mjs",
    "test:review": "node scripts/review-shift.mjs",
    "test:brain": "node --import tsx --test scripts/fish-brain.test.ts",
    "test:m3": "node scripts/smoke-m3.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test:m4": "node scripts/smoke-m4.mjs",
    "test:rooms": "node --import tsx --test scripts/room-*.test.ts",
    "test:m45": "node scripts/smoke-m45.mjs",
    "test:campaign": "node --import tsx --test scripts/campaign.test.ts",
    "test:m5": "node scripts/smoke-m5.mjs",
    "test:m6": "node scripts/smoke-m6.mjs",
    "test:shop": "node --import tsx --test scripts/shop.test.ts",
    "test:cargo": "node --import tsx --test scripts/cargo*.test.ts",
    "test:m7": "node scripts/smoke-m7.mjs",
    "test:pace": "node --import tsx --test scripts/pace.test.ts",
    "test:m8": "node scripts/smoke-m8.mjs",
    "test:popper": "node --import tsx --test scripts/popper.test.ts",
    "test:m9": "node scripts/smoke-m9.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.7",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
