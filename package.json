{
  "name": "fatfish-island",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names Node,Vite \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test:smoke": "node scripts/smoke.mjs",
    "test:review": "node scripts/review-shift.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "concurrently": "10.0.7",
    "playwright-core": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
